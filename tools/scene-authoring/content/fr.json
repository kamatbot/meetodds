      "learner_role": "customer",
      "goal": "order food and a drink, then ask for the bill",
      "filler": "Alors, voyons voir…",
      "beats": [
        {
          "goal": "greet and choose a drink",
          "opener": "Bonjour ! Qu'est-ce que vous voulez boire ?",
          "options": "De l'eau ou un jus ?"
        },
        {
          "goal": "order food; offer a dish",
          "opener": "On a des pizzas et des salades. Qu'est-ce que vous voulez manger ?",
          "options": "Pizza ou salade ?"
        },
        {
          "goal": "ask how the food tastes",
          "opener": "Alors, ça vous plaît ?",
          "options": "C'est bon ou pas ?"
        },
        {
          "goal": "ask for the bill and finish",
          "opener": "Vous voulez autre chose, ou je vous apporte l'addition ?",
          "options": "Autre chose ou l'addition ?"
        }
      ],
      "target_structures": [
        [
          "je voudrais + nom",
          "vous avez… ?"
        ],
        [
          "j'aimerais",
          "vous pourriez m'apporter… ?"
        ],
        [
          "conditional politeness",
          "complaining politely"
        ]
      ]
    },
    {
