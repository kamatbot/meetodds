# Optional MeetOdds-owned integrations.
# Leave analytics blank unless a MeetOdds-owned PostHog project is configured.
MEETODDS_POSTHOG_API_KEY=

# Runtime/development override for the local LLM helper.
MEETODDS_LLAMA_HELPER=

# Trusted FFmpeg executable used when packaging the desktop app.
MEETODDS_FFMPEG_BINARY=
